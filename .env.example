# Server (Express API) env — copy to server/.env for local dev.
# On a host (Heroku et al.) set these as config vars instead; nothing here is read
# from the frontend repo, which has its own .env.example.
#
# Only the Supabase pair below is required — the server throws on boot without it.
# Everything else has a working default; the comments give it.

# ─── Supabase (auth + database) ───────────────────────────────────────────────
# REQUIRED. Project URL — Supabase -> Settings -> API. No trailing slash.
SUPABASE_URL=https://your-project-ref.supabase.co

# REQUIRED. The SECRET (service_role) key, not the anon/publishable one.
# Grants full admin access: it bypasses RLS and can manage any auth user, which is
# exactly what src/config/supabase.ts relies on — every route's authorization is
# enforced in application code (middleware/requireRole + per-handler scoping)
# rather than by RLS. NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ─── HTTP ─────────────────────────────────────────────────────────────────────
# PORT wins when set — hosts inject it themselves, so leave it alone locally.
# API_PORT is the local-dev fallback. With neither set the server listens on 3001.
# PORT=
API_PORT=3001

# Comma-separated browser origins allowed to call this API — scheme + host, no
# trailing slash, no path. Must match the web origin EXACTLY or the browser blocks
# the request with no server-side error to go on. localhost/127.0.0.1 are always
# allowed regardless. Falls back to NEXT_PUBLIC_WEB_URL, then http://localhost:3000;
# server.ts warns at boot if this is unset while NODE_ENV=production.
CORS_ORIGINS=http://localhost:3000

# The web app's public origin. Read here only as the CORS_ORIGINS fallback, so it
# can be left unset if CORS_ORIGINS is spelled out. (The name is shared with the
# frontend's own copy of this variable — this is not a NEXT_PUBLIC_* leak.)
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Set by the host in production. Controls two things: 5xx error bodies stop
# carrying internal detail (middleware/errorHandler.ts), and the CORS warning above
# becomes active. Leave unset locally.
# NODE_ENV=production

# ─── Outbound messaging (SMS / WhatsApp) ──────────────────────────────────────
# Shared by BOTH message types:
#   1. Daily closing summaries — 2 AM, to staff in notification_recipients.
#   2. Order confirmation SMS  — per order, to the customer's own number.
# One provider, one retry policy, one notification_logs table for both.
#
# With all of this unset the server runs the LOG provider: messages are written to
# the server log and recorded in notification_logs, but nothing reaches a real
# phone. That is a deliberate fallback, not a failure — a missing credential must
# never take down the nightly closing job or 500 an order — and the admin
# Notification Recipients page shows a "Test mode" banner while it is in effect.

# 'twilio' | 'log'. Leave unset to auto-detect: Twilio when its credentials below
# are complete, otherwise log. Setting 'twilio' with incomplete credentials logs a
# warning and still falls back.
# NOTIFICATION_PROVIDER=twilio

# Twilio credentials — Twilio Console -> Account Info. A provider is only
# considered configured when SID and token are both present AND at least one of the
# two senders is set; anything less falls back to the log provider.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMS-capable Twilio number, E.164 with the leading +. REQUIRED for order
# confirmations — those are SMS-only (see below), so with this unset the provider
# is considered unconfigured and everything falls back to the log provider.
# TWILIO_SMS_FROM=+14155551234

# WhatsApp sender, E.164 — the code adds the `whatsapp:` prefix itself, so do NOT
# include it here. NOTE: outside a 24-hour customer-service window Meta only allows
# PRE-APPROVED TEMPLATE messages, and a daily closing summary is an unsolicited
# business-initiated message. In production the body must match an approved
# template or Twilio rejects it with error 63016.
# TWILIO_WHATSAPP_FROM=+14155238886

# Retry policy for a failed send. Attempt N waits NOTIFICATION_RETRY_DELAY_MS * N
# (linear backoff). maxAttempts counts the first try, so 3 = one send + two retries.
# NOTIFICATION_RETRY_MAX=3
# NOTIFICATION_RETRY_DELAY_MS=2000

# ─── Order confirmation SMS ───────────────────────────────────────────────────
# Sends the customer their order number and total when an order is placed
# (POST /api/orders) or a POS sale is rung up with a phone number
# (POST /api/orders/pos). Uses the Twilio config above.
#
# TWO switches must both be on for a message to leave the building:
#   1. Settings -> Order Confirmation SMS (settings.order_confirmations_enabled,
#      default FALSE) — the admin-facing toggle. Off means not even an attempt.
#   2. A working provider above. With no TWILIO_SMS_FROM the log provider takes
#      over and the message is logged, not sent.
#
# SMS only, not WhatsApp: outside a 24-hour customer-service window Meta requires
# a PRE-APPROVED TEMPLATE, and a confirmation to someone who has never messaged
# the business is exactly that case (Twilio error 63016).
#
# Each order gets at most ONE successful confirmation per channel, enforced by a
# partial unique index on notification_logs (migration 32) — a double-submit or a
# replayed request cannot bill a second SMS.

# Country code assumed for numbers stored without one — digits only, no '+'.
# Staff type numbers as '0300-1234567'; utils/phone.ts turns that into
# '+923001234567' before it reaches Twilio, which rejects non-E.164 with error
# 21211. Defaults to 92 (Pakistan), matching the Asia/Karachi business day.
# SMS_DEFAULT_COUNTRY_CODE=92

# ─── Login & Session Security ─────────────────────────────────────────────────
# All three are optional and all three have working defaults. Nothing here is a
# credential.
#
# GEOIP_ENABLED=false switches off the IP → country/city lookup entirely. The
# sessions and failed attempts are still recorded; their location columns stay
# null and the UI shows them as unresolved. Set it if sending staff IP addresses
# to a third party is not a trade you want to make — that IP is the ONLY thing
# sent, never the email, the role or the branch.
# GEOIP_ENABLED=true
#
# GEOIP_URL swaps the provider. A template with `{ip}` in it. The default is
# ipapi.co over HTTPS with no account and no key (~1,000 lookups a day, which
# this uses a small fraction of: one per NEW session, never per ping, cached per
# IP on top). The response is read under both ipapi.co's and ipinfo.io's field
# spellings, so those two and freeipapi.com have a fair chance of working
# unchanged. A lookup that fails, times out or is rate-limited never fails the
# login — the row is written with null geo columns.
# GEOIP_URL=https://ipapi.co/{ip}/json/
#
# LOGIN_SESSION_IDLE_MINUTES is how long a still-open session may go without
# checking in before Admin → Security shows it as Idle rather than Active.
# Default 6 (three missed pings); clamped between 1 and 10, since at 10 the
# session already reads as expired. It affects DISPLAY only — nothing is signed
# out, expired or blocked on this number.
# LOGIN_SESSION_IDLE_MINUTES=6

# ─── Seeding (node scripts/seed.js only) ──────────────────────────────────────
# Read solely by the seed script; the running server never looks at them. The
# defaults shown are the ones baked into scripts/seed.js — override them for
# anything you would not want to be public knowledge, and change the passwords
# immediately after seeding a real environment.
# SEED_ADMIN_EMAIL=admin@mountainbakes.com
# SEED_ADMIN_PASSWORD=Admin@123
# SEED_MANAGER_EMAIL=dha.manager@mountainbakes.com
# SEED_MANAGER_PASSWORD=Manager@123
# SEED_MANAGER2_EMAIL=gulshan.manager@mountainbakes.com
# SEED_MANAGER2_PASSWORD=Manager@123
# SEED_PRODUCTION_EMAIL=production@mountainbakes.com
# SEED_PRODUCTION_PASSWORD=Production@123

# ─── Not read yet ─────────────────────────────────────────────────────────────
# Present in some existing .env files, for the pending @supabase/server migration.
# Nothing in src/ reads these today — SUPABASE_SERVICE_ROLE_KEY above is what the
# server actually uses. SUPABASE_SECRET_KEY holds the same secret under the newer
# Supabase key naming.
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# SUPABASE_SECRET_KEY=sb_secret_xxx
# SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Railway service "auth" — image: supabase/gotrue:v2.193.1
# (the version Supabase runs for this project; see supabase/.temp/gotrue-version.
#  Keep it pinned: on start it migrates the auth schema to ITS version, and the
#  restored schema is at exactly this one.)
# No public domain. Reached only by the gateway over the private network.

# ── From `pnpm railway:secrets` (infra/railway/.secrets.env) ────────────────
GOTRUE_DB_DRIVER=postgres
GOTRUE_DB_DATABASE_URL=postgres://supabase_auth_admin:<AUTH_ADMIN_PASSWORD>@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/mountainbakes
GOTRUE_JWT_SECRET=<JWT_SECRET>

# ── Addresses ───────────────────────────────────────────────────────────────
# Railway's private network is IPv6.
GOTRUE_API_HOST=::
GOTRUE_API_PORT=9999
# The PUBLIC address of this server, as clients see it through the gateway.
API_EXTERNAL_URL=https://<gateway-domain>/auth/v1
# The web app. Password-reset emails link back to <site>/reset-password.
GOTRUE_SITE_URL=https://<web-app-domain>
GOTRUE_URI_ALLOW_LIST=https://<web-app-domain>/**

# ── Tokens: the same shape Supabase issues, so middleware/auth.ts is unchanged ─
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_AUD=authenticated
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
GOTRUE_JWT_ADMIN_ROLES=service_role

# ── Browser access ──────────────────────────────────────────────────────────
# REQUIRED. supabase-js sends these headers on every call; on Supabase a
# gateway in front allowed them. Without this line the browser's preflight is
# refused and nobody can sign in on the web. (Verified against v2.193.1.)
GOTRUE_CORS_ALLOWED_HEADERS=apikey,x-supabase-api-version,x-client-info

# ── Accounts ────────────────────────────────────────────────────────────────
# Accounts are created by the API (POST /api/users) with the service key, which
# this does not affect. It stops anyone registering themselves with the anon key.
GOTRUE_DISABLE_SIGNUP=true
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=false
GOTRUE_SECURITY_MANUAL_LINKING_ENABLED=true

# ── TOTP (the finance login) ────────────────────────────────────────────────
GOTRUE_MFA_TOTP_ENROLL_ENABLED=true
GOTRUE_MFA_TOTP_VERIFY_ENABLED=true

# ── Email (password reset) ──────────────────────────────────────────────────
# Supabase's built-in sender does not come with you. Any SMTP provider works.
# Until these are set, "forgot password" sends nothing.
GOTRUE_SMTP_HOST=
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_ADMIN_EMAIL=
GOTRUE_SMTP_SENDER_NAME=Mountain Bakes
GOTRUE_MAILER_URLPATHS_RECOVERY=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_INVITE=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# ── Google sign-in (web) ────────────────────────────────────────────────────
# Same OAuth client as today. In Google Cloud Console add the redirect URI
# below to that client BEFORE the cutover; the Supabase one can stay alongside.
GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=https://<gateway-domain>/auth/v1/callback

# The one public door of the Railway stack.
#
# supabase-js is given a single base URL and derives the rest: the Auth server
# at <url>/auth/v1 and PostgREST at <url>/rest/v1. Neither server knows about
# those prefixes, so this strips them and forwards. That is all it does —
# no key check, no rewriting of bodies. Each upstream authenticates its own
# callers from the JWT.
#
# Railway terminates TLS in front of this, so it listens on plain HTTP.
# AUTH_UPSTREAM / REST_UPSTREAM are the two services' PRIVATE addresses,
# e.g. auth.railway.internal:9999 and postgrest.railway.internal:3000.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	handle /health {
		respond "ok" 200
	}

	handle_path /auth/v1/* {
		reverse_proxy {$AUTH_UPSTREAM}
	}

	handle_path /rest/v1/* {
		reverse_proxy {$REST_UPSTREAM}
	}

	# Storage, Realtime, GraphQL and Functions are not part of this stack.
	handle {
		respond `{"error":"not found"}` 404
	}
}

# Railway service "postgrest" — image: postgrest/postgrest:v14.5
# (the version Supabase runs for this project; see supabase/.temp/rest-version)
# No public domain. Reached only by the gateway over the private network.

# From `pnpm railway:secrets` (infra/railway/.secrets.env). The database name is
# the one in RAILWAY_DB_URL — NOT Railway's default "railway" database.
PGRST_DB_URI=postgres://authenticator:<AUTHENTICATOR_PASSWORD>@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/mountainbakes
PGRST_JWT_SECRET=<JWT_SECRET>

PGRST_DB_SCHEMAS=public
PGRST_DB_ANON_ROLE=anon
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions

# Supabase caps every response at 1000 rows and the API is written around that
# (its pagination loops stop on a short page). Leave it.
PGRST_DB_MAX_ROWS=1000

# Aggregates stay off, as on Supabase: the API uses the data_engine_aggregate
# SQL function instead (migration 108).
# PGRST_DB_AGGREGATES_ENABLED=false

PGRST_DB_POOL=10

# Railway's private network is IPv6. "*6" listens on both.
PGRST_SERVER_HOST=*6
PGRST_SERVER_PORT=3000
